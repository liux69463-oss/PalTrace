# 复制为 .env 后按需修改（服务启动时会自动加载）
#
# 优先级：命令行 / export 的环境变量  >  .env 文件  >  config.py 里的默认值
# （load_dotenv() 默认不会覆盖已存在的环境变量）

# ---------- 存储 ----------
# es = 写入 Elasticsearch 7.x；memory = 内存环形缓冲（无 ES 冒烟/开发用）
STORAGE_BACKEND=es

ES_URL=http://localhost:9200
ES_USER=
ES_PASSWORD=
# 索引前缀，实际索引为 <prefix>-YYYY.MM.DD
# 注意：改前缀后**查不到改名之前的历史索引**（旧数据不会自动迁移），
# 表现就是看板突然一片空白，很容易误判成 ES 挂了
ES_INDEX_PREFIX=paltrace-spans
ES_VERIFY_CERTS=false
# 每次写入后立即 refresh，低吞吐下便于立刻看到数据；生产高吞吐建议 false
ES_REFRESH=true

MEMORY_MAX_SPANS=20000

# ---------- 端口 ----------
# FastAPI 单端口提供：OTLP/HTTP(/v1/traces) + 统计 API(/api/*) + 看板(/)
HTTP_PORT=8000
# OTLP/gRPC 标准端口，LoongSuite 默认即为此端口
GRPC_PORT=4317
#
# 默认关闭 gRPC 接收，原因：同机运行 Jaeger 时会串数据。
#   Jaeger v2 自带 OTel 自埋点，其 OTLP exporter 默认指向 localhost:4317，
#   与 PalTrace 的 gRPC 端口相同 —— 于是 Jaeger 的自描述 trace
#   （如 /api/v3/operations，约每分钟一条）会被 PalTrace 收进来变成噪声。
#
# 何时改回 true：采集端用 gRPC 上报（LoongSuite 默认）时必须开，否则数据收不到。
# 同机有 Jaeger 又要用 gRPC 的折中：给 PalTrace 换端口（GRPC_PORT=14317），
# 或让采集端改用 HTTP/protobuf 上报到 :8000。
ENABLE_GRPC=false

# ---------- 解析 ----------
# 丢弃可能包含用户输入正文的属性，不入库
DROP_ATTRIBUTES=gen_ai.prompt,gen_ai.completion

# 统计默认时间窗口（小时）
DEFAULT_HOURS=24
